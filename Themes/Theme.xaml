<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Whitebox.Controls"
                    xmlns:core="clr-namespace:Whitebox.Core">

    <!-- ============ Typography ============ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============ Palette ============ -->
    <SolidColorBrush x:Key="Bg" Color="#0B0D13" />
    <SolidColorBrush x:Key="Sidebar" Color="#0F1219" />
    <SolidColorBrush x:Key="CardBrush" Color="#141824" />
    <SolidColorBrush x:Key="CardAlt" Color="#10131C" />
    <SolidColorBrush x:Key="CardHover" Color="#1A1F2E" />
    <SolidColorBrush x:Key="Selected" Color="#1E2436" />
    <SolidColorBrush x:Key="Stroke" Color="#20263A" />
    <SolidColorBrush x:Key="StrokeStrong" Color="#2D3550" />
    <SolidColorBrush x:Key="Text" Color="#ECEEF5" />
    <SolidColorBrush x:Key="SubText" Color="#8D94AC" />
    <SolidColorBrush x:Key="Muted" Color="#5E6580" />
    <SolidColorBrush x:Key="Accent" Color="#8B6CFF" />
    <SolidColorBrush x:Key="Accent2" Color="#36C9FF" />
    <SolidColorBrush x:Key="Success" Color="#2FE0A5" />
    <SolidColorBrush x:Key="Warning" Color="#FFB547" />
    <SolidColorBrush x:Key="Danger" Color="#FF5C7A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1F2536" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0" />
        <GradientStop Color="#36C9FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradHome" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0" />
        <GradientStop Color="#36C9FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradClean" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2FE0A5" Offset="0" />
        <GradientStop Color="#21A0FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradPerf" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A4C" Offset="0" />
        <GradientStop Color="#FF4F8B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradStartup" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC24B" Offset="0" />
        <GradientStop Color="#FF7A45" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradApps" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B8CFF" Offset="0" />
        <GradientStop Color="#9F6BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradLarge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#36C9FF" Offset="0" />
        <GradientStop Color="#2FE0A5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradDupes" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5C9A" Offset="0" />
        <GradientStop Color="#B36BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradSpace" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4BE1FF" Offset="0" />
        <GradientStop Color="#5B6CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradTools" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3B6" Offset="0" />
        <GradientStop Color="#2F86FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradDanger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A6A" Offset="0" />
        <GradientStop Color="#FF3D7F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FillPurple" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#558B6CFF" Offset="0" />
        <GradientStop Color="#008B6CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FillOrange" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FF7A55" Offset="0" />
        <GradientStop Color="#00FF7A55" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FillBlue" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5536C9FF" Offset="0" />
        <GradientStop Color="#0036C9FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FillGreen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#442FE0A5" Offset="0" />
        <GradientStop Color="#002FE0A5" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ Converters ============ -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <core:InverseBoolConverter x:Key="InvBool" />
    <core:BytesConverter x:Key="Bytes" />
    <core:StateVisibilityConverter x:Key="StateVis" />
    <core:CountVisibilityConverter x:Key="CountVis" />
    <core:NullVisibilityConverter x:Key="NullVis" />
    <core:InitialConverter x:Key="Initial" />
    <core:NameToBrushConverter x:Key="NameBrush" />
    <core:PercentToFractionConverter x:Key="Frac" />
    <core:FractionWidthConverter x:Key="FracWidth" />

    <!-- ============ Text ============ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource SubText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============ Surfaces ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ Buttons ============ -->
    <Style x:Key="BaseButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
                        <Border x:Name="hover" Background="White" Opacity="0" CornerRadius="10" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.14" />
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="22,10" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#181D2B" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource GradDanger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="22,10" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Accent2}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SubText}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Big circular action button (Smart Care) -->
    <Style x:Key="OrbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="sc" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{TemplateBinding Background}" Opacity="0.35" Margin="-14">
                            <Ellipse.Effect>
                                <BlurEffect Radius="40" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="hover" Fill="White" Opacity="0" />
                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="1.5" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.18" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource SubText}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1C2131" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Navigation ============ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubText}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="bg" CornerRadius="10" Background="{StaticResource Selected}" Opacity="0" />
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource AccentGradient}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20"
                                       Text="{Binding (c:UiProps.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="1" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Accent2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavSection" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="14,18,0,6" />
    </Style>

    <!-- ============ Check box / switch ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="box" CornerRadius="6" BorderBrush="#3A4260" BorderThickness="1.5" Background="#0F121A" />
                            <Border x:Name="fill" CornerRadius="6" Background="{StaticResource AccentGradient}" Opacity="0" />
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                        <ContentPresenter x:Name="content" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fill" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="fill" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Text" Value="&#xE738;" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="track" CornerRadius="12" Background="#252B3D" BorderBrush="#343C55" BorderThickness="1" />
                        <Border x:Name="on" CornerRadius="12" Background="{StaticResource AccentGradient}" Opacity="0" />
                        <Ellipse x:Name="knob" Width="16" Height="16" Fill="#C9CDDB" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="tx" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="on" Property="Opacity" Value="1" />
                            <Setter TargetName="knob" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Chips (selectable pill list) ============ -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SubText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="9" Background="#151a27" BorderBrush="{StaticResource Stroke}" BorderThickness="1" />
                        <Border x:Name="sel" CornerRadius="9" Background="{StaticResource AccentGradient}" Opacity="0" />
                        <ContentPresenter Margin="14,7" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource CardHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="sel" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Lists ============ -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource CardHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbars ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="#2A3146" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#414A66" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#55608A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VScroll" TargetType="ScrollBar">
        <Grid Background="Transparent" Width="10">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HScroll" TargetType="ScrollBar">
        <Grid Background="Transparent" Height="10">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,2">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Template" Value="{StaticResource VScroll}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HScroll}" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Inputs ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="10" Background="#10131C" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="ph" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                       Text="{Binding (c:UiProps.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource TrackBrush}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1B2030" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Page header ============ -->
    <Style TargetType="c:PageHeader">
        <Setter Property="Margin" Value="0,0,0,22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PageHeader">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="14" Background="{TemplateBinding Accent}">
                            <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="White" />
                        </Border>
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H1}" />
                            <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Sub}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon tile used in rows -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="#1A2031" />
    </Style>

    <!-- Section label inside lists -->
    <Style x:Key="ListHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="12,0,12,8" />
    </Style>

</ResourceDictionary>
