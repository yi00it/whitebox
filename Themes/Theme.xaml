<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Whitebox.Controls"
                    xmlns:core="clr-namespace:Whitebox.Core">

    <!--
        "Sticker print": outlined shapes, hard offset shadows, flat pastels, a sunny accent.
        Nothing glows and nothing has a gradient — every surface looks printed, on light or dark paper.
    -->

    <!-- ============ Typography ============ -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Fraunces 72pt</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============ Palette ============ -->
    <!-- Theme-dependent brushes (Ink, Bg, CardBrush, ...) live in Light.xaml / Dark.xaml and are always used
         through DynamicResource so the theme can switch at runtime. Pastel fills below are shared by both themes;
         anything drawn on top of them uses OnFill. -->
    <SolidColorBrush x:Key="Accent" Color="#FFCF33" />
    <SolidColorBrush x:Key="Zest" Color="#FFCF33" />
    <SolidColorBrush x:Key="Mint" Color="#7EE2C2" />
    <SolidColorBrush x:Key="Coral" Color="#FF9B85" />
    <SolidColorBrush x:Key="Sky" Color="#8CC8FF" />
    <SolidColorBrush x:Key="Lilac" Color="#C2B0FF" />
    <SolidColorBrush x:Key="Pink" Color="#FFB0D0" />
    <SolidColorBrush x:Key="Peach" Color="#FFC48A" />
    <SolidColorBrush x:Key="Aqua" Color="#7FD5E6" />
    <SolidColorBrush x:Key="Pistachio" Color="#C9E58C" />
    <SolidColorBrush x:Key="Tomato" Color="#F0544F" />
    <SolidColorBrush x:Key="Banner" Color="#FFE7A3" />

    <SolidColorBrush x:Key="AccentGradient" Color="#FFCF33" />
    <SolidColorBrush x:Key="GradHome" Color="#FFCF33" />
    <SolidColorBrush x:Key="GradClean" Color="#7EE2C2" />
    <SolidColorBrush x:Key="GradPerf" Color="#FF9B85" />
    <SolidColorBrush x:Key="GradStartup" Color="#FFC48A" />
    <SolidColorBrush x:Key="GradApps" Color="#FFB0D0" />
    <SolidColorBrush x:Key="GradLarge" Color="#7FD5E6" />
    <SolidColorBrush x:Key="GradDupes" Color="#C2B0FF" />
    <SolidColorBrush x:Key="GradSpace" Color="#8CC8FF" />
    <SolidColorBrush x:Key="GradTools" Color="#C9E58C" />
    <SolidColorBrush x:Key="GradDanger" Color="#F0544F" />

    <SolidColorBrush x:Key="FillPurple" Color="#C2B0FF" />
    <SolidColorBrush x:Key="FillOrange" Color="#FF9B85" />
    <SolidColorBrush x:Key="FillBlue" Color="#8CC8FF" />
    <SolidColorBrush x:Key="FillGreen" Color="#7EE2C2" />

    <!-- ============ Converters ============ -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <core:InverseBoolConverter x:Key="InvBool" />
    <core:BytesConverter x:Key="Bytes" />
    <core:StateVisibilityConverter x:Key="StateVis" />
    <core:CountVisibilityConverter x:Key="CountVis" />
    <core:NullVisibilityConverter x:Key="NullVis" />
    <core:InitialConverter x:Key="Initial" />
    <core:NameToBrushConverter x:Key="NameBrush" />
    <core:PercentToFractionConverter x:Key="Frac" />
    <core:FractionWidthConverter x:Key="FracWidth" />

    <!-- ============ Text ============ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource SubText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============ Surfaces ============ -->
    <Style x:Key="Card" TargetType="c:Surface">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="ShadowBrush" Value="{DynamicResource Shadow}" />
        <Setter Property="ShadowOffset" Value="5" />
        <Setter Property="Margin" Value="0,0,5,5" />
    </Style>
    <!-- Inner panel on a card: outlined, no shadow -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="c:UiProps.Pill" Value="True" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnFill}" />
    </Style>
    <!-- Eyebrow label above a headline -->
    <Style x:Key="Eyebrow" TargetType="Border">
        <Setter Property="c:UiProps.Pill" Value="True" />
        <Setter Property="Padding" Value="12,4,12,5" />
        <Setter Property="Background" Value="{StaticResource Zest}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnFill}" />
    </Style>
    <!-- Outlined colour tile holding an icon glyph -->
    <Style x:Key="Tile" TargetType="c:Surface">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="ShadowBrush" Value="{DynamicResource Shadow}" />
        <Setter Property="ShadowOffset" Value="2.5" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnFill}" />
    </Style>

    <!-- ============ Buttons ============ -->
    <!-- Pill with ink outline and a hard shadow; pressing pushes the face into the shadow. -->
    <Style x:Key="BaseButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="root">
                        <Border x:Name="shadow" c:UiProps.Pill="True" Background="{DynamicResource Shadow}" Margin="3,3,0,0" />
                        <Border x:Name="face" c:UiProps.Pill="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Margin="0,0,3,3">
                            <Grid>
                                <Border x:Name="hover" c:UiProps.Pill="True" Background="{DynamicResource Ink}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="3" Y="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Zest}" />
        <Setter Property="Foreground" Value="{DynamicResource OnFill}" />
        <Setter Property="Padding" Value="22,10" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Tomato}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="22,10" />
    </Style>

    <!-- Text link: ink, lime underline swash on hover -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="swash" Background="{DynamicResource Swash}" Height="7" VerticalAlignment="Bottom" Margin="-2,0,-2,0" Opacity="0" />
                            <Border Height="1.5" Background="{DynamicResource Ink}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                            <ContentPresenter Margin="0,0,0,3" RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="swash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" c:UiProps.Pill="True" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Zest}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big round "Scan" button -->
    <Style x:Key="OrbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Zest}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Ellipse Fill="{DynamicResource Shadow}" Margin="7,7,0,0" />
                        <Grid x:Name="face" Margin="0,0,7,7">
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <Ellipse x:Name="hover" Fill="{DynamicResource Ink}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="7" Y="7" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CaptionHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Danger}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Navigation ============ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <c:Surface x:Name="bg" c:UiProps.Pill="True" Background="{StaticResource Zest}" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5"
                                   ShadowBrush="{DynamicResource Shadow}" ShadowOffset="3" Margin="0,0,3,3" Opacity="0" />
                        <Border x:Name="hover" c:UiProps.Pill="True" Background="{DynamicResource NavHover}" Margin="0,0,3,3" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,3" VerticalAlignment="Center">
                            <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20"
                                       Text="{Binding (c:UiProps.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="1" />
                            <Setter TargetName="hover" Property="Opacity" Value="0" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource OnFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavSection" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="16,18,0,6" />
    </Style>

    <!-- ============ Check box / switch ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="box" CornerRadius="5" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" Background="{DynamicResource CardBrush}" />
                            <Border x:Name="fill" CornerRadius="5" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" Background="{StaticResource Zest}" Opacity="0" />
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource OnFill}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                        <ContentPresenter x:Name="content" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource CheckHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fill" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="fill" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                            <Setter TargetName="mark" Property="Text" Value="&#xE738;" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="46" Height="26" Background="Transparent">
                        <Border x:Name="track" CornerRadius="13" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" />
                        <Ellipse x:Name="knob" Width="16" Height="16" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5"
                                 HorizontalAlignment="Left" Margin="5,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="tx" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Zest}" />
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnFill}" />
                            <Setter TargetName="knob" Property="Stroke" Value="{DynamicResource OnFill}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Chips (selectable pill list) ============ -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" c:UiProps.Pill="True" Background="Transparent" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5">
                        <ContentPresenter Margin="13,5,13,6" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Lists ============ -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbars ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="{DynamicResource ThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VScroll" TargetType="ScrollBar">
        <Grid Background="Transparent" Width="10">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HScroll" TargetType="ScrollBar">
        <Grid Background="Transparent" Height="10">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,2">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Template" Value="{StaticResource VScroll}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HScroll}" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Inputs ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Zest}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" c:UiProps.Pill="True" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Ink}" />
                            <TextBlock x:Name="ph" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                                       Text="{Binding (c:UiProps.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource FocusFill}" />
                            <Setter TargetName="b" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Zest}" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border c:UiProps.Pill="True" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" Padding="2">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" c:UiProps.Pill="True" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Ink}" CornerRadius="8" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:RingGauge">
        <Setter Property="TrackBrush" Value="{DynamicResource TrackBrush}" />
    </Style>

    <!-- ============ Page header ============ -->
    <Style TargetType="c:PageHeader">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PageHeader">
                    <DockPanel LastChildFill="True">
                        <c:Surface DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="16" Background="{TemplateBinding Accent}"
                                   BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" ShadowBrush="{DynamicResource Shadow}" ShadowOffset="4"
                                   VerticalAlignment="Center" Margin="0,0,4,4">
                            <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource OnFill}" />
                        </c:Surface>
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H1}" />
                            <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Sub}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon tile used in rows -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource CardAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- Section label inside lists -->
    <Style x:Key="ListHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="12,0,12,8" />
    </Style>

</ResourceDictionary>
