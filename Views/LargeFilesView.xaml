<UserControl x:Class="Whitebox.Views.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Large files" Subtitle="Find the biggest files hiding on your drives." Glyph="&#xE8B7;" Accent="{StaticResource GradLarge}" />

        <!-- Options -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Scanning}" />
                    <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource GradLarge}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="Scan" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="LOCATION" Style="{StaticResource Caption}" Width="80" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Choose folder…" Command="{Binding BrowseCommand}" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" DisplayMemberPath="Label" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="MIN SIZE" Style="{StaticResource Caption}" Width="80" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" DisplayMemberPath="Label" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10,16,6,10">
            <Grid>
                <DockPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Results}">
                    <DockPanel DockPanel.Dock="Bottom" Margin="12,10,14,2">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding RecycleCommand}" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Move to Recycle Bin" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SubText}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /> selected ·
                            <Run Text="{Binding SelectedSize, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                        </TextBlock>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,0,14,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Label" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Files}" Padding="0,0,6,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="12,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" />
                                    <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="14,0">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="13.5" />
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Sub}" FontSize="11.5" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource Bytes}}" FontSize="13.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="12" Foreground="{StaticResource SubText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show in Explorer" Margin="12,0,0,0"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Idle -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Idle}">
                    <Border Width="84" Height="84" CornerRadius="26" Background="{StaticResource GradLarge}" Opacity="0.9">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="36" Foreground="White" />
                    </Border>
                    <TextBlock Text="Pick a drive and scan" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding Status, TargetNullValue='Large, forgotten files are the fastest way to win back space.'}" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Scanning -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Scanning}">
                    <c:Spinner Width="64" Height="64" Thickness="5" Brush="{StaticResource GradLarge}" />
                    <TextBlock Text="Scanning…" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
