<UserControl x:Class="Whitebox.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Startup apps" Subtitle="{Binding Summary}" Glyph="&#xE7E8;" Accent="{StaticResource GradStartup}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Task Manager" Command="{Binding OpenTaskManagerCommand}" Margin="0,0,10,0" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,16,6,10">
            <Grid>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1E1A12" CornerRadius="10" Padding="14,10" Margin="8,0,14,12"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Warning}" />
                            <TextBlock Text="Items for all users can only be changed when Whitebox runs as administrator." Margin="10,0,0,0"
                                       Foreground="#E8C68A" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Items}" Padding="0,0,6,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="12,10" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="42" Height="42">
                                        <Grid>
                                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0" ToolTip="{Binding Command}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center" MinWidth="170">
                                        <TextBlock Text="{Binding Publisher, TargetNullValue='Unknown publisher'}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Sub}" FontSize="11.5" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open file location" Margin="0,0,12,0"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" Margin="0,0,6,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <c:Spinner Width="36" Height="36" Brush="{StaticResource GradStartup}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
