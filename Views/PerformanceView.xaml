<UserControl x:Class="Whitebox.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Performance" Subtitle="Live system activity and the apps using your resources."
                      Glyph="&#xE9D9;" Accent="{StaticResource GradPerf}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OptimizeStatus}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource GradPerf}" Command="{Binding OptimizeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="Free up memory" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <!-- Charts -->
        <UniformGrid Grid.Row="1" Columns="3" Height="196">
            <c:Surface Style="{StaticResource Card}" Margin="0,0,9,0" Padding="20,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Monitor.CpuText}" Style="{StaticResource H2}" FontSize="26" FontWeight="Black" />
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <c:Sparkline Values="{Binding Monitor.CpuHistory}" Maximum="100" Stroke="{DynamicResource Ink}" Fill="{StaticResource FillOrange}" Margin="0,14,0,0" />
                </DockPanel>
            </c:Surface>
            <c:Surface Style="{StaticResource Card}" Margin="3,0,6,0" Padding="20,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Monitor.RamPercent, StringFormat={}{0:0}%}" Style="{StaticResource H2}" FontSize="26" FontWeight="Black" />
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Monitor.RamText}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <c:Sparkline Values="{Binding Monitor.RamHistory}" Maximum="100" Stroke="{DynamicResource Ink}" Fill="{StaticResource FillPurple}" Margin="0,14,0,0" />
                </DockPanel>
            </c:Surface>
            <c:Surface Style="{StaticResource Card}" Margin="9,0,0,0" Padding="20,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}">
                                <Run Text="↓" /> <Run Text="{Binding Monitor.DownText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Danger}">
                                <Run Text="↑" /> <Run Text="{Binding Monitor.UpText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NETWORK" Style="{StaticResource Caption}" />
                            <TextBlock Text="All adapters" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <c:Sparkline Values="{Binding Monitor.DownHistory}" Stroke="{DynamicResource Ink}" Fill="{StaticResource FillBlue}" />
                        <c:Sparkline Values="{Binding Monitor.UpHistory}" Stroke="{DynamicResource Danger}" />
                    </Grid>
                </DockPanel>
            </c:Surface>
        </UniformGrid>

        <!-- Processes -->
        <c:Surface Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10,16,6,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,0,14,12">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Processes" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="12">
                            <Run Text="{Binding ProcessCount, Mode=OneWay}" /> running · <Run Text="{Binding ThreadCount, Mode=OneWay, StringFormat=N0}" /> threads
                        </TextBlock>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource SearchBox}" Width="220" c:UiProps.Placeholder="Filter processes"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,10,0" />
                        <Button Style="{StaticResource DangerButton}" Command="{Binding EndTaskCommand}" Padding="16,9" Content="End task" />
                    </StackPanel>
                    <Border />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0,26,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NAME" Style="{StaticResource Caption}" Margin="46,0,0,0" />
                    <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="THREADS" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>

                <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}" Padding="0,0,6,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                            <Setter Property="Padding" Value="12,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{Binding Name, Converter={StaticResource NameBrush}}" BorderBrush="{DynamicResource OnFill}" BorderThickness="1.5">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" Foreground="{DynamicResource OnFill}" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Pid}" FontSize="12.5" Foreground="{DynamicResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Threads}" FontSize="12.5" Foreground="{DynamicResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </c:Surface>
    </Grid>
</UserControl>
