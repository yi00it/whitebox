<UserControl x:Class="Whitebox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Greeting}" Subtitle="Smart Care cleans junk, frees memory and checks what slows your PC down — in one click."
                      Glyph="&#xE945;" Accent="{StaticResource GradHome}" />

        <!-- ================= Hero ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" MinHeight="340">
            <Grid>
                <!-- soft glows -->
                <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-140,0,0,0" Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8B6CFF" Offset="0" />
                            <GradientStop Color="#008B6CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-220" Opacity="0.16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#36C9FF" Offset="0" />
                            <GradientStop Color="#0036C9FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Idle -->
                <Grid Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Idle}" Margin="48,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource OrbButton}" Width="190" Height="190" Command="{Binding ScanCommand}">
                        <StackPanel>
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="34" />
                            <TextBlock Text="Scan" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="48,0,0,0">
                        <TextBlock Text="Let's give your PC a checkup" Style="{StaticResource H1}" FontSize="30" />
                        <TextBlock Text="Smart Care looks for system junk, browser and app caches, and memory hogs, then lets you fix everything at once."
                                   Style="{StaticResource Sub}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,22" MaxWidth="520" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1A2132" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Success}" />
                                    <TextBlock Text="Cleanup" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource SubText}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#1A2132" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Foreground="#FF7A65" />
                                    <TextBlock Text="Speed" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource SubText}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#1A2132" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent2}" />
                                    <TextBlock Text="Privacy" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource SubText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Scanning / Cleaning -->
                <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Scanning,Cleaning'}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="190" Height="190">
                        <c:RingGauge Value="{Binding Progress}" Thickness="12" Brush="{StaticResource AccentGradient}" TrackBrush="{StaticResource TrackBrush}" />
                        <c:Spinner Width="150" Height="150" Thickness="2" Brush="#5536C9FF" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Big}" FontSize="36"
                                       Text="{Binding Progress, StringFormat={}{0:P0}}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Sub}"
                                       Text="{Binding State}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Step}" Style="{StaticResource Sub}" FontSize="14" HorizontalAlignment="Center" Margin="0,24,0,0" />
                </StackPanel>

                <!-- Results -->
                <Grid Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Results}" Margin="40,32" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Here's what we found" Style="{StaticResource H1}" />
                        <TextBlock Text="Pick what to fix, then hit Run." Style="{StaticResource Sub}" FontSize="13.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,22">
                        <!-- Cleanup card -->
                        <Border Background="#171C2A" CornerRadius="14" Padding="20" Margin="0,0,10,0" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource GradClean}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="White" />
                                    </Border>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DoClean}" VerticalAlignment="Top" />
                                    <TextBlock Text="Cleanup" Style="{StaticResource H3}" Margin="12,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding JunkSize, Converter={StaticResource Bytes}}" Style="{StaticResource Big}" FontSize="32" Margin="0,18,0,0" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding JunkDetail}" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Review details →" HorizontalAlignment="Left" Margin="-8,12,0,0"
                                        VerticalAlignment="Bottom" Command="{Binding GoCommand}" CommandParameter="cleanup" />
                                <Border />
                            </DockPanel>
                        </Border>
                        <!-- Memory card -->
                        <Border Background="#171C2A" CornerRadius="14" Padding="20" Margin="5,0" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource GradPerf}">
                                        <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="White" />
                                    </Border>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DoMemory}" VerticalAlignment="Top" />
                                    <TextBlock Text="Memory" Style="{StaticResource H3}" Margin="12,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding RamAtScan, StringFormat={}{0:0}% used}" Style="{StaticResource Big}" FontSize="32" Margin="0,18,0,0" />
                                <TextBlock DockPanel.Dock="Top" Text="Trim idle apps' memory so active ones get more room." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Open Performance →" HorizontalAlignment="Left" Margin="-8,12,0,0"
                                        VerticalAlignment="Bottom" Command="{Binding GoCommand}" CommandParameter="performance" />
                                <Border />
                            </DockPanel>
                        </Border>
                        <!-- Startup card -->
                        <Border Background="#171C2A" CornerRadius="14" Padding="20" Margin="10,0,0,0" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource GradStartup}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Startup" Style="{StaticResource H3}" Margin="12,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding StartupEnabled, StringFormat={}{0} apps}" Style="{StaticResource Big}" FontSize="32" Margin="0,18,0,0" />
                                <TextBlock DockPanel.Dock="Top" Text="launch when you sign in. Fewer startup apps means a faster boot." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Manage startup →" HorizontalAlignment="Left" Margin="-8,12,0,0"
                                        VerticalAlignment="Bottom" Command="{Binding GoCommand}" CommandParameter="startup" />
                                <Border />
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Padding="34,12" FontSize="15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Run Smart Care" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Start over" Margin="10,0,0,0" Command="{Binding ResetCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Done -->
                <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Done}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="130" Height="130" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource GradClean}" Opacity="0.35" Margin="-10">
                            <Ellipse.Effect>
                                <BlurEffect Radius="30" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Fill="{StaticResource GradClean}" />
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="52" Foreground="White" />
                    </Grid>
                    <TextBlock Text="{Binding DoneTitle}" Style="{StaticResource H1}" FontSize="30" HorizontalAlignment="Center" Margin="0,26,0,0" />
                    <TextBlock Text="{Binding DoneDetail}" Style="{StaticResource Sub}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,22"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600" />
                    <Button Style="{StaticResource GhostButton}" Content="Scan again" HorizontalAlignment="Center" Command="{Binding ResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Live tiles ================= -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,18,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                <DockPanel>
                    <Grid Width="70" Height="70" DockPanel.Dock="Left">
                        <c:RingGauge Value="{Binding Monitor.Cpu, Converter={StaticResource Frac}}" Thickness="7" Brush="{StaticResource GradPerf}" />
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource SubText}" />
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Monitor.CpuText}" Style="{StaticResource H2}" FontSize="22" />
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource Sub}" FontSize="11.5" ToolTip="{Binding CpuName}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0,6,0">
                <DockPanel>
                    <Grid Width="70" Height="70" DockPanel.Dock="Left">
                        <c:RingGauge Value="{Binding Monitor.RamPercent, Converter={StaticResource Frac}}" Thickness="7" Brush="{StaticResource GradHome}" />
                        <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="{StaticResource SubText}" />
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MEMORY" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Monitor.RamPercent, StringFormat={}{0:0}%}" Style="{StaticResource H2}" FontSize="22" />
                        <TextBlock Text="{Binding Monitor.RamText}" Style="{StaticResource Sub}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,3,0">
                <DockPanel>
                    <Grid Width="70" Height="70" DockPanel.Dock="Left">
                        <c:RingGauge Value="{Binding DriveUsed}" Thickness="7" Brush="{StaticResource GradClean}" />
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="{StaticResource SubText}" />
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STORAGE" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DriveUsed, StringFormat={}{0:P0}}" Style="{StaticResource H2}" FontSize="22" />
                        <TextBlock Text="{Binding DriveText}" Style="{StaticResource Sub}" FontSize="11.5" ToolTip="{Binding DriveName}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="9,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SYSTEM" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding MachineName}" Style="{StaticResource H2}" FontSize="17" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OsName}" Style="{StaticResource Sub}" FontSize="11.5" />
                    <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Text="{Binding Monitor.Uptime, StringFormat=Up {0}}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
