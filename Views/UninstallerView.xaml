<UserControl x:Class="Whitebox.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Uninstaller" Subtitle="{Binding Summary}" Glyph="&#xE71D;" Accent="{StaticResource GradApps}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Store apps" Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"
                        ToolTip="Microsoft Store apps are managed in Windows Settings" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <c:Surface Grid.Row="1" Style="{StaticResource Card}" Padding="10,16,6,10">
            <Grid>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,0,14,12">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource SearchBox}" c:UiProps.Placeholder="Search apps or publishers" MaxWidth="380" HorizontalAlignment="Left"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Apps}" Padding="0,0,6,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="12,9" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="42" Height="42">
                                        <Grid>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontWeight="Bold" FontSize="15"
                                                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
                                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open install folder" Margin="16,0,6,0"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Grid Grid.Column="5" Width="104">
                                        <Button Style="{StaticResource GhostButton}" Content="Uninstall" Padding="14,7" FontSize="12.5"
                                                Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"
                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <c:Spinner Width="14" Height="14" Thickness="2" Brush="{DynamicResource Ink}" />
                                            <TextBlock Text="Waiting…" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource SubText}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <c:Spinner Width="36" Height="36" Brush="{DynamicResource Ink}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </c:Surface>
    </Grid>
</UserControl>
