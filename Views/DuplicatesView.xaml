<UserControl x:Class="Whitebox.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Duplicates" Subtitle="Byte-for-byte identical files, verified with SHA-256." Glyph="&#xE8C8;" Accent="{StaticResource GradDupes}" />

        <c:Surface Grid.Row="1" Style="{StaticResource Card}" Padding="20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Scanning}" />
                    <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource GradDupes}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="Scan" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Choose folder…" Command="{Binding BrowseCommand}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="LOCATION" Style="{StaticResource Caption}" Width="80" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" DisplayMemberPath="Label" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="MIN SIZE" Style="{StaticResource Caption}" Width="80" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" DisplayMemberPath="Label" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </c:Surface>

        <c:Surface Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10,16,6,10">
            <Grid>
                <DockPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Results}">
                    <DockPanel DockPanel.Dock="Top" Margin="12,0,14,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding AutoSelectCommand}" Padding="14,8"
                                ToolTip="Selects every copy except the oldest in each set">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE762;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Auto-select duplicates" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="12,10,14,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding RecycleCommand}" Padding="18,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Move to Recycle Bin" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource SubText}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" /> selected ·
                            <Run Text="{Binding SelectedSize, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                        </TextBlock>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource PlainItem}" Padding="0,0,6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Padding="14,12" Margin="2,0,2,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <c:Surface Style="{StaticResource Tile}" Width="32" Height="32" CornerRadius="9" Background="{StaticResource GradDupes}">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource OnFill}" />
                                            </c:Surface>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="13.5" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}" FontSize="11.5" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="6,0,14,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="12" Foreground="{DynamicResource SubText}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Show in Explorer" Width="30" Height="28" Margin="10,0,0,0"
                                                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Idle}">
                    <c:Surface Style="{StaticResource Tile}" Width="84" Height="84" CornerRadius="26" Background="{StaticResource GradDupes}">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="36" Foreground="{DynamicResource OnFill}" />
                    </c:Surface>
                    <TextBlock Text="Find identical copies" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding Status, TargetNullValue='Downloads, photos and backups often hide duplicate copies.'}" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Scanning}">
                    <c:Spinner Width="64" Height="64" Thickness="5" Brush="{DynamicResource Ink}" />
                    <TextBlock Text="Looking for duplicates…" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </c:Surface>
    </Grid>
</UserControl>
