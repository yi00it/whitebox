<UserControl x:Class="Whitebox.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <Grid Margin="36,4,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Cleanup" Subtitle="System junk, caches and privacy traces. History, cookies and passwords are never touched."
                      Glyph="&#xE74D;" Accent="{StaticResource GradClean}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Content="Cancel"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Scan" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Category list -->
            <Border Style="{StaticResource Card}" Padding="10,14,6,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,0,14,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                            <Button Style="{StaticResource LinkButton}" Content="None" Command="{Binding SelectNoneCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar DockPanel.Dock="Top" Style="{StaticResource SlimProgress}" Value="{Binding Progress}" Height="4" Margin="12,0,14,8"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" Padding="0,0,6,0">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="14,14,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsAvailable}" />
                                    <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="14,0,14,0">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="13.5" />
                                            <Border Style="{StaticResource Chip}" Background="#2A2340"
                                                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Admin" FontSize="10.5" FontWeight="SemiBold" Foreground="#B9A6FF" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="#3A2C17"
                                                    Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Running — close to clean" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" Margin="12,0,6,0" MinWidth="80">
                                        <c:Spinner Width="16" Height="16" Thickness="2" Brush="{StaticResource Success}" HorizontalAlignment="Right"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Summary + details -->
            <DockPanel Grid.Column="1" Margin="18,0,0,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid Width="150" Height="150" HorizontalAlignment="Center">
                            <c:RingGauge Value="1" Thickness="10" Brush="{StaticResource GradClean}" Opacity="0.9" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSize, Converter={StaticResource Bytes}}" Style="{StaticResource H1}" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="selected" Style="{StaticResource Sub}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Sub}" Margin="0,14,0,16"
                                   Text="{Binding TotalFound, Converter={StaticResource Bytes}, StringFormat=Found {0} in total}" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}" HorizontalAlignment="Stretch"
                                Background="{StaticResource GradClean}" Padding="0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Clean" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                Content="Restart as administrator to clean system areas" Command="{Binding RestartAdminCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="10,16,6,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,10">
                            <TextBlock Text="{Binding Selected.Name, FallbackValue='Details', TargetNullValue='Details'}" Style="{StaticResource H3}" />
                            <TextBlock Text="Select a category to see its largest files" Style="{StaticResource Sub}" FontSize="12"
                                       Visibility="{Binding Selected, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
                            <TextBlock Style="{StaticResource Sub}" FontSize="12"
                                       Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
                                <Run Text="{Binding Selected.Count, Mode=OneWay, StringFormat={}{0:N0} items}" /> · <Run Text="{Binding Selected.Size, Mode=OneWay, Converter={StaticResource Bytes}}" />
                            </TextBlock>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SelectedFiles}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                    <Setter Property="Padding" Value="10,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Path}">
                                        <DockPanel.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}" />
                                        </DockPanel.InputBindings>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={StaticResource Bytes}}" FontSize="12" Foreground="{StaticResource SubText}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
