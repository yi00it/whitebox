<UserControl x:Class="Whitebox.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Whitebox.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="36,4,30,28">
            <c:PageHeader Title="Toolkit" Subtitle="One-click maintenance and repair tools." Glyph="&#xE90F;" Accent="{StaticResource GradTools}">
                <Button Style="{StaticResource GhostButton}" Command="{Binding RestartAdminCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Restart as administrator" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </c:PageHeader>

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- compact row: icon · title, description and status · action -->
                        <c:Surface Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:Surface Style="{StaticResource Tile}" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top"
                                           Background="{Binding Title, Converter={StaticResource NameBrush}}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource OnFill}" />
                                </c:Surface>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Height="32" Margin="0,3,0,0" ToolTip="{Binding Description}" />
                                    <DockPanel Height="20" Margin="0,2,0,0">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{StaticResource Lilac}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Admin" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnFill}" />
                                        </Border>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Sub}" FontSize="11.5" Foreground="{DynamicResource Success}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Spinner Width="16" Height="16" Thickness="2" Brush="{DynamicResource Ink}" Margin="0,0,10,0"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding ActionText}" Command="{Binding Command}" Padding="14,6" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </c:Surface>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Power plans -->
            <c:Surface Style="{StaticResource Card}" Margin="0,0,14,0" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <c:Surface Style="{StaticResource Tile}" Width="36" Height="36" CornerRadius="10" Background="{StaticResource GradStartup}">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource OnFill}" />
                        </c:Surface>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Power plan" Style="{StaticResource H3}" FontSize="14" />
                            <TextBlock Text="High performance keeps the CPU ready at full speed; Balanced saves energy." Style="{StaticResource Sub}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Plans}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ActivatePlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Margin="0,0,10,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GradStartup}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OnFill}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:Surface>
        </StackPanel>
    </ScrollViewer>
</UserControl>
