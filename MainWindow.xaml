<Window x:Class="Whitebox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Whitebox.Controls"
        Title="Whitebox" Width="1320" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,1.5,0">
            <DockPanel Margin="16,16,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,0,20">
                    <!-- badge: the white box -->
                    <Grid Width="44" Height="44">
                        <Ellipse Fill="{StaticResource Zest}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" />
                        <Viewbox Margin="10,9,10,10">
                            <Canvas Width="26" Height="28">
                                <Path Data="M13,1 L25,8 L13,15 L1,8 Z" Fill="White" Stroke="{DynamicResource OnFill}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <Path Data="M1,8 L13,15 L13,27 L1,20 Z" Fill="#F4F2FA" Stroke="{DynamicResource OnFill}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                <Path Data="M13,15 L25,8 L25,20 L13,27 Z" Fill="#E4E0F1" Stroke="{DynamicResource OnFill}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Whitebox" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="Black" />
                        <TextBlock Text="Clean · Optimize · Protect" FontSize="11" Foreground="{DynamicResource SubText}" Margin="1,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- footer: version + project link -->
                <DockPanel DockPanel.Dock="Bottom" Margin="6,12,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="GitHub" Padding="4,0" FontSize="11.5"
                            Click="Project_Click" ToolTip="Source code, releases and issue tracker" />
                    <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- footer: admin state -->
                <c:Surface DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="14,12" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5"
                           ShadowBrush="{DynamicResource Ink}" ShadowOffset="4" Margin="0,0,4,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdminGlyph" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock x:Name="AdminText" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AdminSub" FontSize="11.5" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button x:Name="AdminButton" Style="{StaticResource PrimaryButton}" Content="Restart as admin" Margin="0,10,0,0"
                                Padding="0,7" FontSize="12.5" HorizontalContentAlignment="Center" Click="AdminButton_Click" />
                    </StackPanel>
                </c:Surface>

                <!-- footer: update available (shown by the daily update check) -->
                <c:Surface x:Name="UpdateCard" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="14,12"
                           BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" ShadowBrush="{DynamicResource Ink}" ShadowOffset="4" Margin="0,0,4,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24">
                                <Ellipse Fill="{StaticResource Zest}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" />
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource OnFill}" />
                            </Grid>
                            <TextBlock Text="Update available" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateSub" FontSize="11.5" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button x:Name="UpdateNotes" Style="{StaticResource LinkButton}" Content="What's new" FontSize="11.5" Padding="0" Margin="0,4,0,0"
                                HorizontalAlignment="Left" Click="UpdateNotes_Click" />
                        <ProgressBar x:Name="UpdateProgress" Style="{StaticResource SlimProgress}" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed" />
                        <Grid x:Name="UpdateButtons" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Content="Later" Padding="0,7" FontSize="12.5" HorizontalContentAlignment="Center" Click="UpdateLater_Click" />
                            <Button x:Name="UpdateNowButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Update" Padding="0,7" FontSize="12.5" HorizontalContentAlignment="Center" Click="UpdateNow_Click" />
                        </Grid>
                    </StackPanel>
                </c:Surface>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <StackPanel x:Name="NavPanel">
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE945;" Content="Smart Care" Tag="home" Checked="Nav_Checked" />

                        <TextBlock Style="{StaticResource NavSection}" Text="CLEANUP" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE74D;" Content="System Junk" Tag="cleanup" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE8B7;" Content="Large Files" Tag="large" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE8C8;" Content="Duplicates" Tag="dupes" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xEDA2;" Content="Space Lens" Tag="space" Checked="Nav_Checked" />

                        <TextBlock Style="{StaticResource NavSection}" Text="SPEED" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE9D9;" Content="Performance" Tag="performance" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE7E8;" Content="Startup Apps" Tag="startup" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE71D;" Content="Uninstaller" Tag="apps" Checked="Nav_Checked" />

                        <TextBlock Style="{StaticResource NavSection}" Text="UTILITIES" />
                        <RadioButton Style="{StaticResource NavButton}" c:UiProps.Glyph="&#xE90F;" Content="Toolkit" Tag="tools" Checked="Nav_Checked" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" FontSize="13" Click="Theme_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
        </Grid>

        <!-- ================= Toasts ================= -->
        <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Width="360" />

        <!-- ================= Dialog ================= -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}">
            <c:Surface x:Name="DialogCard" Width="460" Style="{StaticResource Card}" CornerRadius="22" ShadowOffset="8" Margin="0"
                       Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <c:Surface.RenderTransform>
                    <ScaleTransform x:Name="DialogScale" />
                </c:Surface.RenderTransform>
                <StackPanel>
                    <c:Surface x:Name="DialogIcon" Style="{StaticResource Tile}" Width="50" Height="50" CornerRadius="14" HorizontalAlignment="Left" Background="{StaticResource Zest}">
                        <TextBlock x:Name="DialogGlyph" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="20" />
                    </c:Surface>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="23" Margin="0,18,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource Sub}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource GhostButton}" Content="Cancel" IsCancel="True" />
                        <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </c:Surface>
        </Grid>
    </Grid>
</Window>
